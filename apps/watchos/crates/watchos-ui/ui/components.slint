import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
export { Icon } from "icons.slint";
export component WatchButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <float> scale: 1;
    callback tapped();
    forward-focus: focus;
    height: max(Theme.row-height, Theme.row-height * root.scale);
    border-radius: self.height / 2;
    background: touch.pressed || touch.has-hover ? Theme.raised : root.active ? Theme.primary.with-alpha(0.19) : Theme.surface;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.primary;
    animate background, border-color { duration: Theme.reduced-motion ? 0ms : 130ms; easing: ease-out; }
    accessible-role: button; accessible-label: root.label + (root.active ? ", selected" : "");
    accessible-action-default => { root.tapped(); }
    Text { x: 9px; width: parent.width - 18px; text: root.label; color: root.active ? Theme.primary : Theme.ink; font-size: max(Theme.body-size, Theme.body-size * root.scale); font-weight: 500; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    focus := FocusScope { key-pressed(event) => { if event.text == "\n" || event.text == " " { root.tapped(); return accept; } reject } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.tapped(); } }
}
export component Caption inherits Text {
    in property <float> scale: 1;
    color: Theme.muted; font-family: Theme.body-font; font-size: Theme.body-size * root.scale; line-height-factor: Theme.line-height; wrap: word-wrap;
    horizontal-alignment: center; vertical-alignment: center;
}
export component Complication inherits Rectangle {
    in property <bool> reference-layout: false;
    in property <int> kind;
    in property <string> value;
    in property <string> status;
    in property <string> label: "Complication";
    in property <int> accent: 0;
    in property <int> style: 0;
    in property <float> scale: 1;
    callback tapped();
    background: transparent;
    border-radius: self.width / 2;
    Rectangle { y: 0px; width: parent.width; height: root.reference-layout ? parent.height - 1px * root.scale : parent.height; border-radius: self.width / 2; background: Theme.surface.with-alpha(root.reference-layout ? 0.75 : 0.55); }
    accessible-role: button;
    accessible-label: root.label + ": " + root.value + ", " + root.status;
    accessible-action-default => { root.tapped(); }
    Icon { visible: root.style != 2; x: (parent.width - self.width) / 2; y: root.style == 1 ? (parent.height - self.height) / 2 : (root.reference-layout ? 7px : Theme.complication-icon-top) * root.scale; width: Theme.complication-icon-size * root.scale; height: self.width; kind: root.kind; ink: Theme.accent-color(root.accent); }
    Text { visible: root.style != 1; y: root.style == 2 ? (parent.height - self.height) / 2 : Theme.complication-value-top * root.scale; width: parent.width; height: 19px * root.scale; text: root.value; color: Theme.ink; font-family: Theme.display-font; font-size: Theme.complication-value-size * root.scale; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-alignment: center; }
    TouchArea { y: (parent.height - max(44px * root.scale, parent.height)) / 2; width: parent.width; height: max(44px * root.scale, parent.height); mouse-cursor: pointer; clicked => { root.tapped(); } }
}
export component MenuRow inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    in property <string> detail;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <float> scale: 1;
    callback tapped();
    forward-focus: focus;
    height: max(Theme.row-height, (root.detail == "" ? Theme.row-height : 48px) * root.scale);
    border-radius: self.height / 2;
    background: touch.pressed || touch.has-hover ? Theme.raised : root.selected ? Theme.primary.with-alpha(0.19) : Theme.surface;
    border-width: focus.has-focus ? 2px : 0px; border-color: Theme.primary;
    animate background { duration: Theme.reduced-motion ? 0ms : 130ms; }
    accessible-role: button; accessible-label: root.label + (root.detail == "" ? "" : ", " + root.detail) + (root.selected ? ", selected" : "");
    accessible-action-default => {root.tapped();}
    Icon { x: 13px * root.scale; y: (parent.height - self.height) / 2; width: Theme.icon-size * root.scale; height: self.width; kind: root.kind; ink: root.selected ? Theme.primary : Theme.muted; selected: root.selected; disabled: root.disabled; }
    Text { x: 42px * root.scale; y: root.detail == "" ? 0px : 4px * root.scale; width: parent.width - 54px * root.scale; height: root.detail == "" ? parent.height : 18px * root.scale; text: root.label; font-family: Theme.body-font; font-size: Theme.body-size * root.scale; font-weight: 500; color: root.selected ? Theme.primary : Theme.ink; vertical-alignment: center; overflow: elide; }
    Text { visible: root.detail != ""; x: 42px * root.scale; y: 24px * root.scale; width: parent.width - 54px * root.scale; height: 17px * root.scale; text: root.detail; font-family: Theme.body-font; font-size: Theme.small-size * root.scale; color: Theme.muted; vertical-alignment: center; overflow: elide; }
    focus := FocusScope { key-pressed(event) => {if event.text == "\n" || event.text == " " {root.tapped(); return accept;} reject} }
    touch := TouchArea { mouse-cursor: pointer; clicked => {focus.focus(); root.tapped();} }
}
